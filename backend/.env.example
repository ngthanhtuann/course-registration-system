# Neon: paste the pooled connection string from Connect, keeping SSL parameters.
# DATABASE_URL takes precedence over all db_* values. Never commit real credentials.
DATABASE_URL=
# Optional direct (non-pooler) connection for setup_database.py.
DIRECT_DATABASE_URL=
DB_CONNECT_TIMEOUT=15
# Pool limits per backend process; connection timeout also bounds pool waiting.
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_TIMEZONE=Asia/Ho_Chi_Minh
# Leave empty to preserve SSL options from DATABASE_URL.
DB_SSLMODE=

# Used only when DATABASE_URL is empty (local PostgreSQL).
db_host=localhost
db_port=5432
db_name=course_registration_system
db_user=postgres
db_password=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
